      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "sum by (pool, transport) (puntohunter_workers_connected{host=\"eu\"})",
          "legendFormat": "{{pool}} {{transport}}"
