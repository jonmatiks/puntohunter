# Settings for the scripts run from the operator's machine: deploy.sh, unlock.sh, and payout-wallet.sh.
# Copy this file to deploy.env beside it, which git ignores, and set what your server needs. Each script reads
# deploy.env when it exists; a variable set in the environment takes precedence over the file.

# The SSH destination, user@host, of the server that runs the pool. Required.
#PUNTOHUNTER_HOST=root@pool.example.com

# deploy.sh: the installation directory, which holds the running puntohunter binary.
#PUNTOHUNTER_DIR=/opt/puntohunter

# unlock.sh and payout-wallet.sh: the command that runs bitcoin-cli against the node, on the server, as a user
# that can reach the node's RPC. The default is bitcoin-cli on the SSH user's PATH, with the node's default
# datadir.
#PUNTOHUNTER_BITCOIN_CLI="sudo -u bitcoin /opt/bitcoin/bin/bitcoin-cli -conf=/opt/bitcoin/bitcoin.conf -datadir=/opt/bitcoin/data"

# unlock.sh and payout-wallet.sh: the payout wallet's name, [payouts] wallet in the pool's config.
#PUNTOHUNTER_WALLET=payouts

# unlock.sh and payout-wallet.sh: the command that runs one shell command on the server.
#PUNTOHUNTER_REMOTE="ssh $PUNTOHUNTER_HOST"

# unlock.sh: the pool's health check, which says whether a payout batch waits for the unlock. Required.
#PUNTOHUNTER_HEALTH_URL=https://pool.example.com/api/v1/health

# payout-wallet.sh: where the node writes the new wallet's backup, a path on the server its user can write.
# Required.
#PUNTOHUNTER_HOST_BACKUP=/opt/bitcoin/data/payouts-backup.dat

# payout-wallet.sh: where the backup is kept on this machine.
#PUNTOHUNTER_WALLET_BACKUP=$HOME/puntohunter-keys/payouts-wallet.dat
